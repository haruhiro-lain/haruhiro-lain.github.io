---
import {
	SITE_FOOTER_NAME,
	SITE_FOOTER_POWERED_BY_NAME,
	SITE_FOOTER_POWERED_BY_URL,
	SITE_START_YEAR,
} from '../consts';
import FloatingActions from './FloatingActions.vue';

const currentYear = new Date().getFullYear();
const yearText = currentYear <= SITE_START_YEAR ? `${SITE_START_YEAR}` : `${SITE_START_YEAR}-${currentYear}`;
---

<footer class="site-footer" role="contentinfo">
	<div class="site-info-bar" aria-label="站点信息栏">
		<div class="site-info-inner">
			<div class="site-info-left">
				<span class="site-info-year">&copy; {yearText}</span>
				<span class="site-info-sep" aria-hidden="true">&middot;</span>
				<span>{SITE_FOOTER_NAME}</span>
			</div>
			<div class="site-info-right">
				<span>Powered by</span>
				<a href={SITE_FOOTER_POWERED_BY_URL} target="_blank" rel="noopener noreferrer">{SITE_FOOTER_POWERED_BY_NAME}</a>
			</div>
		</div>
	</div>
	<FloatingActions client:load />
</footer>

<style>
	footer {
		padding: 0;
		margin: 0;
		background: transparent;
	}

	.site-info-bar {
		width: 100%;
		min-height: 3rem;
		padding: 0;
		box-sizing: border-box;
		font-size: 0.8rem;
		color: rgb(var(--gray-dark));
		background: var(--overlay-bg);
		border-top: 1px solid var(--overlay-border);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.site-info-inner {
		width: min(100%, var(--content-width-base));
		max-width: var(--content-width-base);
		min-height: 3rem;
		margin: 0 auto;
		padding: 0 1rem;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-info-left,
	.site-info-right {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.site-info-year,
	.site-info-sep {
		white-space: nowrap;
	}

	.site-info-inner a {
		color: inherit;
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.site-info-inner {
			min-height: 3rem;
			font-size: 0.75rem;
			padding: 0 0.75rem;
			white-space: nowrap;
			overflow-x: auto;
		}

		.site-info-sep {
			margin: 0 0.15rem;
		}
	}
</style>
