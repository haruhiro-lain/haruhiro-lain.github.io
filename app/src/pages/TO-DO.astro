---
import fs from 'node:fs';
import path from 'node:path';
import PageShell from '../layouts/PageShell.astro';

const todoModules = import.meta.glob('../../../TO-DO/*.md', {
	eager: true,
});

const todoEntries = Object.entries(todoModules)
	.map(([filePath, mod]) => {
		const relPath = filePath.replace(/^\.\.\/\.\.\/\.\.\//, '');
		const absPath = path.resolve(process.cwd(), `../${relPath}`);
		const stat = fs.statSync(absPath);
		const normalizedPath = filePath.replaceAll('\\', '/');
		const filename = normalizedPath.split('/').pop()?.replace('.md', '') ?? '';
		const html = (mod as any).compiledContent?.() ?? '';
		return { filename, html: html as string, ctime: stat.birthtimeMs };
	})
	.sort((a, b) => a.ctime - b.ctime);
---

<PageShell title="TO-DO">
	<main>
		{
			todoEntries.length === 0 ? (
				<p class="empty-indicator">暂无草稿</p>
			) : (
				todoEntries.map((entry) => (
					<div class="draft-item">
						<h2 class="draft-item__title">{entry.filename}</h2>
						<div class="draft-item__body" set:html={entry.html} />
					</div>
				))
			)
		}
	</main>
</PageShell>

<style>
	.page-title {
		margin-bottom: 1.5rem;
	}

	.draft-item {
		margin-bottom: 2rem;
	}

	.draft-item__title {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
		color: rgb(var(--black));
	}

	.draft-item__body {
		padding: 0.75rem 1rem;
		border: 1px solid var(--overlay-border);
		border-radius: 8px;
		background: var(--overlay-card);
		color: rgb(var(--black));
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.draft-item__body :global(h1) { font-size: 1.4rem; margin: 0 0 0.4rem; }
	.draft-item__body :global(h2) { font-size: 1.2rem; margin: 0.8rem 0 0.3rem; }
	.draft-item__body :global(h3) { font-size: 1.05rem; margin: 0.6rem 0 0.25rem; }
	.draft-item__body :global(p) { margin: 0.3rem 0; }
	.draft-item__body :global(ul),
	.draft-item__body :global(ol) { margin: 0.3rem 0; padding-left: 1.5rem; }
	.draft-item__body :global(li) { margin: 0.15rem 0; }
	.draft-item__body :global(strong) { font-weight: 700; }
	.draft-item__body :global(del) { opacity: 0.55; }

	.empty-indicator {
		color: rgb(var(--gray));
	}
</style>

<script>
	const textareas = document.querySelectorAll('.draft-item__textarea');
	textareas.forEach((ta) => {
		if (ta instanceof HTMLTextAreaElement) {
			ta.style.height = 'auto';
			ta.style.height = ta.scrollHeight + 'px';
		}
	});
</script>
