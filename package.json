{
  "name": "@example/blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-with-sync.mjs",
    "build": "node --env-file-if-exists=.env scripts/sync-hpoi.mjs && node --env-file-if-exists=.env scripts/sync-github-avatar.mjs && astro build",
    "build:full": "node --env-file-if-exists=.env scripts/sync-hpoi.mjs && node --env-file-if-exists=.env scripts/sync-steam.mjs && node --env-file-if-exists=.env scripts/sync-github-avatar.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:hpoi": "node --env-file-if-exists=.env scripts/sync-hpoi.mjs",
    "sync:steam": "node --env-file-if-exists=.env scripts/sync-steam.mjs",
    "sync:github-avatar": "node --env-file-if-exists=.env scripts/sync-github-avatar.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/vue": "^6.0.1",
    "astro": "^6.1.5",
    "mermaid": "^11.15.0",
    "sharp": "^0.34.3",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
