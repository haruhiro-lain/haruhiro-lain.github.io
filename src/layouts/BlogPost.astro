---
import { Image } from 'astro:assets';
import type { MarkdownHeading } from 'astro';
import FormattedDate from '../components/FormattedDate.astro';
import PostNav from '../components/PostNav.astro';
import PostOutline from '../components/PostOutline.vue';
import PageShell from './PageShell.astro';
import FallbackImage from '../assets/sunny.jpg';

type PostLink = {
	title: string;
	href: string;
};

type Props = {
	title?: string;
	description?: string;
	pubDate?: Date;
	tags?: string[];
	updatedDate?: Date;
	heroImage?: any;
	headings?: MarkdownHeading[];
	entryCollection?: string;
	entryId?: string;
	entryBaseDir?: string;
	prevPost?: PostLink;
	nextPost?: PostLink;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	headings = [],
	entryCollection,
	entryId,
	entryBaseDir,
	prevPost,
	nextPost,
} = Astro.props as Props;
const outlineHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
const contentImageModules = import.meta.glob('../content/**/*.{png,jpg,jpeg,webp,avif,gif,svg}', {
	eager: true,
	import: 'default',
	query: '?url',
});
const contentImageUrlMap = contentImageModules as Record<string, string>;

function resolveHeroImage(raw: unknown): { resolved: string; isImageMeta: boolean } | undefined {
	// Astro image() schema returns ImageMetadata object with .src
	if (raw && typeof raw === 'object' && 'src' in (raw as Record<string, unknown>)) {
		return { resolved: (raw as Record<string, string>).src, isImageMeta: true };
	}
	if (typeof raw !== 'string') return undefined;
	const normalized = raw.replaceAll('\\', '/');
	const normalizedBaseDir = (entryBaseDir ?? '').endsWith('/') ? entryBaseDir! : `${entryBaseDir ?? ''}/`;
	let relativeKey: string;
	if (normalized.startsWith('./')) {
		relativeKey = `${normalizedBaseDir}${normalized.slice(2)}`;
	} else if (normalized.startsWith('../')) {
		const srcSegs = normalized.split('/');
		const baseSegs = normalizedBaseDir.split('/').filter(Boolean);
		while (srcSegs[0] === '..') {
			srcSegs.shift();
			if (baseSegs.length > 0) baseSegs.pop();
		}
		relativeKey = `../${[...baseSegs, ...srcSegs].join('/')}`;
	} else {
		relativeKey = `${normalizedBaseDir}${normalized}`;
	}
	const lowerKey = relativeKey.toLowerCase();
	for (const [k, v] of Object.entries(contentImageUrlMap)) {
		if (k.toLowerCase() === lowerKey) return { resolved: v, isImageMeta: false };
	}
	return undefined;
}
const heroImageResult = resolveHeroImage(heroImage);

const isVA11HallA = entryCollection === 'life' && entryId?.replaceAll('\\', '/').toLowerCase().startsWith('va-11_hall-a/');
---

<PageShell title={title} description={description} contentWidth="100%">
	<article class:list={["post-article", outlineHeadings.length > 0 && 'post-article--with-outline']}>
		<PostOutline client:load headings={outlineHeadings} />
		<div class="post-content">
			<div class="hero-image">
				{heroImageResult && heroImageResult.isImageMeta
					? <Image width={1020} height={510} src={heroImage} alt="" />
					: heroImageResult && <Image width={1020} height={510} src={heroImageResult.resolved} alt="" />
				}
			</div>
			<div
				class="prose"
				data-entry-collection={entryCollection}
				data-entry-id={entryId}
				data-entry-base-dir={entryBaseDir}
			>
				{
					(title || pubDate || updatedDate) && (
						<div class="title">
							{(pubDate || updatedDate) && (
								<div class="date">
									{pubDate && <FormattedDate date={pubDate} />}
									{updatedDate && (
										<div class="last-updated-on">
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)}
								</div>
							)}
							{title && !isVA11HallA && <h1>{title}</h1>}
							<hr />
						</div>
					)
				}
				<slot />
			</div>
		</div>
		<PostNav prevPost={prevPost} nextPost={nextPost} />
	</article>

	<script id="content-image-url-map" type="application/json" is:inline set:html={JSON.stringify(contentImageUrlMap)}></script>

	<script is:inline>
	const resolveContentScopedImages = () => {
		const prose = document.querySelector('.prose');
		if (!(prose instanceof HTMLElement)) {
			return;
		}

		const entryBaseDir = prose.dataset.entryBaseDir;
		if (!entryBaseDir) {
			return;
		}

		const mapScript = document.getElementById('content-image-url-map');
		if (!(mapScript instanceof HTMLScriptElement) || !mapScript.textContent) {
			return;
		}

		let imageUrlMap = {};
		try {
			imageUrlMap = JSON.parse(mapScript.textContent);
		} catch {
			return;
		}

		const caseInsensitiveImageUrlMap = Object.create(null);
		for (const [imageKey, imageUrl] of Object.entries(imageUrlMap)) {
			caseInsensitiveImageUrlMap[imageKey.toLowerCase()] = imageUrl;
		}

		const imageNodes = prose.querySelectorAll('img');

		imageNodes.forEach((imageNode) => {
			const rawSrc = (imageNode.getAttribute('src') ?? '').trim();
			const inlineStyle = imageNode.getAttribute('style') ?? '';
			if (!rawSrc) {
				return;
			}

			if (rawSrc.startsWith('/') || rawSrc.startsWith('http') || rawSrc.startsWith('data:')) {
				return;
			}

			const normalizedSrc = rawSrc.replaceAll('\\', '/');
			const normalizedBaseDir = entryBaseDir.endsWith('/') ? entryBaseDir : `${entryBaseDir}/`;
			let resolvedUrl = '';

			if (normalizedSrc.startsWith('./')) {
				const baseRelativeKey = `${normalizedBaseDir}${normalizedSrc.slice(2)}`;
				resolvedUrl = caseInsensitiveImageUrlMap[baseRelativeKey.toLowerCase()] ?? '';
			} else if (normalizedSrc.startsWith('../')) {
				const srcSegments = normalizedSrc.split('/');
				const baseSegments = normalizedBaseDir.split('/').filter(Boolean);
				while (srcSegments[0] === '..') {
					srcSegments.shift();
					if (baseSegments.length > 0) {
						baseSegments.pop();
					}
				}
				const baseRelativeKey = `../${[...baseSegments, ...srcSegments].join('/')}`;
				resolvedUrl = caseInsensitiveImageUrlMap[baseRelativeKey.toLowerCase()] ?? '';
			} else {
				const baseRelativeKey = `${normalizedBaseDir}${normalizedSrc}`;
				resolvedUrl = caseInsensitiveImageUrlMap[baseRelativeKey.toLowerCase()] ?? '';
			}

			if (!resolvedUrl || typeof resolvedUrl !== 'string') {
				const zoomMatch = inlineStyle.match(/(?:^|;)\s*zoom\s*:\s*([\d.]+)\s*%\s*(?:;|$)/i);
				if (zoomMatch) {
					const zoomPercent = Number.parseFloat(zoomMatch[1]);
					if (Number.isFinite(zoomPercent) && zoomPercent > 0) {
						imageNode.style.width = `${zoomPercent}%`;
						imageNode.style.height = 'auto';
						imageNode.style.zoom = '';
					}
				}
				return;
			}

			imageNode.setAttribute('src', resolvedUrl);

			const zoomMatch = inlineStyle.match(/(?:^|;)\s*zoom\s*:\s*([\d.]+)\s*%\s*(?:;|$)/i);
			if (zoomMatch) {
				const zoomPercent = Number.parseFloat(zoomMatch[1]);
				if (Number.isFinite(zoomPercent) && zoomPercent > 0) {
					imageNode.style.width = `${zoomPercent}%`;
					imageNode.style.height = 'auto';
					imageNode.style.zoom = '';
				}
			}
		});
	};

	document.addEventListener('DOMContentLoaded', resolveContentScopedImages);
	document.addEventListener('astro:page-load', resolveContentScopedImages);
	resolveContentScopedImages();
	</script>

	<script>
	async function renderMermaidDiagrams() {
		const mermaidBlocks = document.querySelectorAll('.prose pre[data-language="mermaid"] code');
		if (mermaidBlocks.length === 0) return;

		const { default: mermaid } = await import('mermaid');
		const isLight = document.documentElement.getAttribute('data-theme') === 'light';
		mermaid.initialize({
			startOnLoad: false,
			theme: isLight ? 'default' : 'dark',
			securityLevel: 'loose',
		});

		for (const block of mermaidBlocks) {
			const pre = block.parentElement;
			if (!(pre instanceof HTMLElement)) continue;

			const code = block.textContent ?? '';
			const id = `mermaid-${Math.random().toString(36).slice(2, 9)}`;

			try {
				const { svg } = await mermaid.render(id, code);
				const wrapper = document.createElement('div');
				wrapper.className = 'mermaid-wrapper';
				wrapper.innerHTML = svg;
				pre.replaceWith(wrapper);
			} catch (err) {
				console.error('Mermaid render error:', err);
			}
		}
	}

	document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
	document.addEventListener('astro:page-load', renderMermaidDiagrams);
	renderMermaidDiagrams();
	</script>
</PageShell>

<style>
	.post-article {
		width: 100%;
	}

	.post-article--with-outline {
		padding-left: 220px;
		padding-right: 220px;
		box-sizing: border-box;
	}

	.post-outline {
		--outline-top-offset: calc(3.4rem - 1px);
		position: fixed;
		left: 0;
		top: var(--outline-top-offset) !important;
		width: 220px;
		height: calc(100vh - var(--outline-top-offset)) !important;
		padding: 0;
		box-sizing: border-box;
		z-index: 1050;
		transform: translateX(-100%);
		transition: transform 240ms ease;
	}

	/* 左侧不可见触发区，维持鼠标靠近时展开大纲的逻辑 */
	.post-outline::before {
		content: '';
		position: absolute;
		right: -20px;
		top: 0;
		width: 20px;
		height: 100%;
	}

	.post-outline:hover,
	.post-outline.is-open {
		transform: translateX(0);
	}

	.post-outline__inner {
		height: 100%;
		padding: 1rem 0.9rem;
		border: none;
		background: color-mix(in srgb, var(--overlay-bg-strong) 72%, transparent);
		backdrop-filter: blur(20px) saturate(118%);
		-webkit-backdrop-filter: blur(20px) saturate(118%);
		box-shadow: var(--box-shadow);
		overflow: auto;
	}

	.post-outline__list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.25rem;
	}

	.post-outline__item a {
		display: block;
		padding: 0.35rem 0.45rem;
		border-radius: 8px;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		font-size: 0.94rem;
		line-height: 1.4;
	}

	.post-outline__item a:hover {
		background: var(--overlay-card);
		color: rgb(var(--black));
	}

	.post-outline__item--nested a {
		padding-left: 1.1rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.post-content {
		min-width: 0;
		width: 100%;
	}

	.hero-image {
		width: min(100%, var(--content-width-base));
		margin: 0 auto;
	}

	.hero-image img {
		display: block;
		margin: 0 auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	.prose {
		width: min(100%, var(--content-width-base));
		max-width: 100%;
		margin: auto;
		padding: 1em;
		color: rgb(var(--gray-dark));
	}

	.title {
		margin-bottom: 1em;
		padding: 1em 0;
		text-align: center;
		line-height: 1;
	}

	.title h1 {
		margin: 0 0 0.5em 0;
	}

	.date {
		margin-bottom: 0.5em;
		color: rgb(var(--gray));
	}

	.last-updated-on {
		font-style: italic;
	}

	@media (max-width: 720px) {
		.post-article--with-outline {
			padding-left: 0;
			padding-right: 0;
		}

		.post-outline {
			--outline-top-offset: calc(5.8rem - 1px);
			top: var(--outline-top-offset) !important;
			height: calc(100vh - var(--outline-top-offset)) !important;
			width: 200px;
			transform: translateX(-100%);
		}

		.prose {
			padding: 0.75rem;
		}
	}
</style>
