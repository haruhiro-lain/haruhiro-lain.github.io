---
import PageShell from '../../../layouts/PageShell.astro';
import type { CollectionEntry } from 'astro:content';
import { getSortedPosts } from '../../../utils/content';

const posts = (await getSortedPosts('life')).filter((post: CollectionEntry<'life'>) =>
	post.id.startsWith('weekly/'),
);
---

<PageShell title="周掸" contentWidth="900px">
	<article>
		<h1>周掸</h1>
		<p>（并非）每周更新复盘，能做的事没那么多，不陷入内耗就算成功了说是...</p>
		{posts.length > 0 ? (
			<section>
				<ul class="post-list">
					{posts.map((post: CollectionEntry<'life'>) => (
						<li>
							<a href={`/life/weekly/${post.id.slice('weekly/'.length)}/`}>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		) : (
			<p>周掸暂时还没有文章。</p>
		)}
	</article>
</PageShell>

<style>
	.post-list a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.post-list li {
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 12px;
		padding: 1rem;
	}

	.post-list p {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
	}
</style>