---
import type { CollectionEntry } from 'astro:content';
import CollectionPostPage from '../../components/CollectionPostPage.astro';
import { getCollectionStaticPaths } from '../../utils/content';

export async function getStaticPaths() {
	const posts = await getCollectionStaticPaths('life');
	return posts.filter(({ params }) => {
		const slug = params.slug;
		return typeof slug === 'string' && !slug.includes('/');
	});
}

type Props = CollectionEntry<'life'>;

const post = Astro.props as Props;
---

<CollectionPostPage post={post} />
