---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import PageShell from '../../../layouts/PageShell.astro';
import { getSortedPosts } from '../../../utils/content';
import FallbackImage from '../../../assets/blog-placeholder-about.jpg';
import { cabinetStockList } from '../../../data/cabinetStock';

const normalizePostId = (id: string) => id.replaceAll('\\', '/');
const toVAUppercaseHref = (id: string) => {
	const normalized = normalizePostId(id);
	if (normalized.toLowerCase().startsWith('va-11_hall-a/')) {
		return `/life/VA-11_Hall-A/${normalized.slice('va-11_hall-a/'.length)}/`;
	}
	return `/life/${normalized}/`;
};

const vaPosts = (await getSortedPosts('life')).filter((post: CollectionEntry<'life'>) =>
	normalizePostId(post.id).toLowerCase().startsWith('va-11_hall-a/'),
);

const cabinetStock = [...cabinetStockList].sort(
	(a, b) => b.recentDate.localeCompare(a.recentDate),
);

const normalizeIngredientName = (value: string) => value.replace(/\s+/g, '').toLowerCase();

const parseQuotedStrings = (source: string) =>
	Array.from(source.matchAll(/"([^"]+)"/g)).map((match) => match[1]?.trim() ?? '').filter(Boolean);

const extractSpiritIngredients = (body: string) => {
	const directMatch = body.match(/spiritIngredients\s*[:=][\s\S]*?=\s*\[([\s\S]*?)\]/m);
	if (directMatch?.[1]) {
		return parseQuotedStrings(directMatch[1]);
	}

	const constructorMatch = body.match(/=\s*MkDrinkMenu\s*[\r\n]+\s*(\[[\s\S]*?\])/m);
	if (constructorMatch?.[1]) {
		return parseQuotedStrings(constructorMatch[1]);
	}

	return [];
};

const cabinetStockNames = cabinetStock.map((item) => item.name).filter(Boolean);
const normalizedCabinetNames = cabinetStockNames.map(normalizeIngredientName);

const isIngredientAvailable = (ingredient: string) => {
	const normalizedIngredient = normalizeIngredientName(ingredient);
	return normalizedCabinetNames.some(
		(stock) => stock.includes(normalizedIngredient) || normalizedIngredient.includes(stock),
	);
};

const matchedMenus = vaPosts
	.map((post: CollectionEntry<'life'>) => {
		const spiritIngredients = extractSpiritIngredients(post.body ?? '');
		return {
			title: post.data.title,
			href: toVAUppercaseHref(post.id),
			spiritIngredients,
		};
	})
	.filter((menu) => menu.spiritIngredients.length > 0)
	.filter((menu) => menu.spiritIngredients.every((ingredient) => isIngredientAvailable(ingredient)));
---

<PageShell title="烂酒罐" contentWidth="100%">
	<article class="va-panel">
		<header class="va-header">
			<div class="va-header-left">
				<p class="eyebrow">VA-11 Hall-A: Cyberpunk Bartender Action</p>
				<p class="lead">调制饮料，改变人生</p>
			</div>
			<div class="va-header-right">
				<div class="calicomp-badge">
					<span class="calicomp-face">:)</span>
					<span>CALICOMP.1</span>
				</div>
			</div>
		</header>
		<section class="card-grid">
			<section class="card card--blog">
				<div class="recipe-tabs">
					<span class="recipe-tab recipe-tab--active">按名称</span>
					<span class="recipe-tab">按口味</span>
					<span class="recipe-tab">按种类</span>
				</div>
				<div class="recipe-body">
				{vaPosts.length > 0 ? (
					<ul class="blog-list">
						{vaPosts.map((post: CollectionEntry<'life'>) => (
							<li class="blog-item" data-tags={JSON.stringify(post.data.tags || [])}>
								<a href={toVAUppercaseHref(post.id)}>
									<div class="blog-image">
									<Image width={360} height={180} src={post.data.heroImage ?? FallbackImage} alt={post.data.title} />
									</div>
									<h3 class="blog-title">{post.data.title}</h3>
									<p class="blog-date"><FormattedDate date={post.data.pubDate} /></p>
								</a>
							</li>
						))}
					</ul>
				) : (
					<p class="sub">还没有配方记录，先去调一杯吧。</p>
				)}
				</div>
			</section>

			<section class="card card--stock">
				<div class="stock-brand">
					<span class="stock-brand-face">:)</span>
					<span class="stock-brand-text">CALICOMP.1</span>
					<span class="stock-balance">$ {cabinetStock.length} 种</span>
				</div>
				<div class="sidebar-head">
					<h2>库存原料</h2>
					<button class="sidebar-toggle" id="stock-toggle" type="button" aria-expanded="false">
						展开
					</button>
				</div>
				<ul class="stock-list" id="stock-list">
					{cabinetStock.map((item) => (
						<li>
							<span>{item.name}</span>
							<strong>{item.recentDate || '待记录'}</strong>
						</li>
					))}
				</ul>
				<div class="stock-pagination" id="stock-pagination" hidden>
					<button id="stock-prev" type="button">上一页</button>
					<span id="stock-page-info">1 / 1</span>
					<button id="stock-next" type="button">下一页</button>
				</div>
				<div class="draw-menu">
					<button class="draw-menu-btn" id="draw-menu-btn" type="button">抽卡</button>
					<section class="draw-result" id="draw-result" hidden>
						<h3 id="draw-result-title">今日烂酒罐酒单</h3>
						<p id="draw-result-link-wrap" hidden>
							<a id="draw-result-link" href="#">查看配方</a>
						</p>
						<ul id="draw-result-list"></ul>
						<p id="draw-result-meta"></p>
						<div id="draw-all-list" class="draw-all-list" hidden></div>
					</section>
				</div>
			</section>
		</section>
		<footer class="va-footer-dec">
			<span>设置</span>
			<span>点唱机</span>
			<span>读取</span>
			<span>退出</span>
		</footer>
	</article>
</PageShell>

<script>
	// Lock theme to dark on VA-11 Hall-A page, restore on leave
	(() => {
		const STORAGE_KEY = 'theme-preference';
		const LOCK_KEY = 'va-theme-saved';

		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved) {
			localStorage.setItem(LOCK_KEY, saved);
		}
		localStorage.setItem(STORAGE_KEY, 'dark');
		document.documentElement.setAttribute('data-theme', 'dark');

		// Neutralize theme toggle clicks while on this page
		const guard = () => {
			document.documentElement.setAttribute('data-theme', 'dark');
			localStorage.setItem(STORAGE_KEY, 'dark');
			const btn = document.getElementById('theme-toggle');
			if (btn) {
				btn.textContent = '🌙';
				btn.setAttribute('aria-label', '主题已锁定为深色');
			}
		};
		const toggle = document.getElementById('theme-toggle');
		if (toggle) {
			toggle.addEventListener('click', guard, true);
		}
		guard(); // ensure icon is correct on first load

		const restore = () => {
			const prev = localStorage.getItem(LOCK_KEY);
			if (prev) {
				localStorage.setItem(STORAGE_KEY, prev);
			}
			localStorage.removeItem(LOCK_KEY);
		};

		// Also watch for direct attribute changes
		const observer = new MutationObserver(() => {
			if (document.documentElement.getAttribute('data-theme') !== 'dark') {
				guard();
			}
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		window.addEventListener('beforeunload', restore);
		document.addEventListener('astro:before-swap', () => {
			observer.disconnect();
			restore();
		}, { once: true });
	})();
</script>

<script type="application/json" id="matched-menus-data" set:html={JSON.stringify(matchedMenus)}></script>

<script>
	const initStockPanel = () => {
		const matchedMenusDataElement = document.getElementById('matched-menus-data');
		const matchedMenus = JSON.parse(matchedMenusDataElement?.textContent ?? '[]');

		const stockToggle = document.getElementById('stock-toggle');
		const stockList = document.getElementById('stock-list');
		const stockPagination = document.getElementById('stock-pagination');
		const stockPrev = document.getElementById('stock-prev');
		const stockNext = document.getElementById('stock-next');
		const stockPageInfo = document.getElementById('stock-page-info');
		const drawMenuButton = document.getElementById('draw-menu-btn');
		const drawResult = document.getElementById('draw-result');
		const drawResultTitle = document.getElementById('draw-result-title');
		const drawResultLinkWrap = document.getElementById('draw-result-link-wrap');
		const drawResultLink = document.getElementById('draw-result-link');
		const drawResultList = document.getElementById('draw-result-list');
		const drawResultMeta = document.getElementById('draw-result-meta');
		const drawAllList = document.getElementById('draw-all-list');

		if (
			!stockToggle ||
			!stockList ||
			!stockPagination ||
			!stockPrev ||
			!stockNext ||
			!stockPageInfo ||
			!drawMenuButton ||
			!drawResult ||
			!drawResultTitle ||
			!drawResultLinkWrap ||
			!drawResultLink ||
			!drawResultList ||
			!drawResultMeta
		) {
			return;
		}

		if (stockToggle.dataset.bound === 'true') {
			return;
		}
		stockToggle.dataset.bound = 'true';

		const stockItems = Array.from(stockList.querySelectorAll('li'));
		const collapsedCount = 3;
		const pageSize = 10;
		let expanded = false;
		let currentPage = 1;

		const renderStock = () => {
			if (!expanded) {
				stockItems.forEach((item, index) => {
					item.hidden = index >= collapsedCount;
				});
				stockPagination.hidden = true;
				stockToggle.textContent = '展开';
				stockToggle.setAttribute('aria-expanded', 'false');
				return;
			}

			const totalPages = Math.max(1, Math.ceil(stockItems.length / pageSize));
			if (currentPage > totalPages) currentPage = totalPages;

			const start = (currentPage - 1) * pageSize;
			const end = start + pageSize;

			stockItems.forEach((item, index) => {
				item.hidden = index < start || index >= end;
			});

			stockPagination.hidden = totalPages <= 1;
			stockPageInfo.textContent = `${currentPage} / ${totalPages}`;
			if (currentPage <= 1) {
				stockPrev.setAttribute('disabled', 'disabled');
			} else {
				stockPrev.removeAttribute('disabled');
			}

			if (currentPage >= totalPages) {
				stockNext.setAttribute('disabled', 'disabled');
			} else {
				stockNext.removeAttribute('disabled');
			}
			stockToggle.textContent = '收起';
			stockToggle.setAttribute('aria-expanded', 'true');
		};

		stockToggle.addEventListener('click', () => {
			expanded = !expanded;
			currentPage = 1;
			renderStock();
		});

		stockPrev.addEventListener('click', () => {
			currentPage -= 1;
			renderStock();
		});

		stockNext.addEventListener('click', () => {
			currentPage += 1;
			renderStock();
		});

		const drawRandomMenu = () => {
			if (!Array.isArray(matchedMenus) || matchedMenus.length === 0) {
				drawResultTitle.textContent = '暂无可调酒单';
				drawResultLinkWrap.hidden = true;
				drawResultList.innerHTML = '';
				drawResultMeta.textContent = '当前酒柜剩余无法匹配文章中的酒体材料。';
				if (drawAllList) drawAllList.hidden = true;
				drawResult.hidden = false;
				return;
			}

			const menu = matchedMenus[Math.floor(Math.random() * matchedMenus.length)];
			drawResultTitle.textContent = `${menu.title}`;
			drawResultLink.setAttribute('href', menu.href);
			drawResultLinkWrap.hidden = false;

			drawResultList.innerHTML = '';
			const spiritIngredients = Array.isArray(menu.spiritIngredients) ? menu.spiritIngredients : [];
			for (const ingredient of spiritIngredients) {
				const name = String(ingredient);
				const li = document.createElement('li');
				li.textContent = name;
				drawResultList.appendChild(li);
			}

			// clickable count → show all matched menus
			drawResultMeta.innerHTML = '';
			const prefix = document.createTextNode('在 ');
			const btn = document.createElement('button');
			btn.type = 'button';
			btn.className = 'draw-show-all-btn';
			btn.textContent = `${matchedMenus.length} 篇`;
			btn.addEventListener('click', () => {
				if (!drawAllList) return;
				if (!drawAllList.hidden) {
					drawAllList.hidden = true;
					return;
				}
				drawAllList.innerHTML = '';
				const heading = document.createElement('p');
				heading.className = 'draw-all-heading';
				drawAllList.appendChild(heading);
				for (const m of matchedMenus) {
					const a = document.createElement('a');
					a.href = m.href;
					a.textContent = m.title;
					a.className = 'draw-all-link';
					drawAllList.appendChild(a);
				}
				drawAllList.hidden = false;
			});
			const suffix = document.createTextNode(' 匹配酒单中抽取');
			drawResultMeta.appendChild(prefix);
			drawResultMeta.appendChild(btn);
			drawResultMeta.appendChild(suffix);

			if (drawAllList) drawAllList.hidden = true;
			drawResult.hidden = false;
		};

		drawMenuButton.addEventListener('click', () => {
			drawRandomMenu();
		});

		renderStock();
	};

	const initRecipeTabs = () => {
		const tabs = document.querySelectorAll('.recipe-tab');
		const blogItems = document.querySelectorAll<HTMLElement>('.blog-item');
		const blogList = document.querySelector('.blog-list');
		const recipeBody = document.querySelector('.recipe-body');

		if (!tabs.length || !blogItems.length || !recipeBody || !blogList) return;

		// prevent double-bind on Astro page transitions
		if ((tabs[0] as HTMLElement).dataset.bound === 'true') return;
		(tabs[0] as HTMLElement).dataset.bound = 'true';

		const flavorTags = ['甜味', '酸味', '苦味', '辛辣', '发泡'];
		const categoryTags = ['经典', '女性化', '男性化', '时尚', '宣传', '复古'];

		const showAllBlogItems = () => {
			blogItems.forEach((item) => {
				item.hidden = false;
			});
			const sub = recipeBody.querySelector('.recipe-submenu');
			if (sub) sub.remove();
		};

		const showSubMenu = (tags: string[]) => {
			const existing = recipeBody.querySelector('.recipe-submenu');
			if (existing) existing.remove();
			blogItems.forEach((item) => {
				item.hidden = true;
			});

			const subMenu = document.createElement('div');
			subMenu.className = 'recipe-submenu';

			const backBtn = document.createElement('button');
			backBtn.type = 'button';
			backBtn.className = 'recipe-submenu-back';
			backBtn.textContent = '← 返回';
			backBtn.addEventListener('click', () => {
				showAllBlogItems();
				tabs.forEach((t) => t.classList.remove('recipe-tab--active'));
				tabs[0].classList.add('recipe-tab--active');
			});
			subMenu.appendChild(backBtn);

			const list = document.createElement('ul');
			list.className = 'recipe-submenu-list';

			for (const tag of tags) {
				const li = document.createElement('li');
				const btn = document.createElement('button');
				btn.type = 'button';
				btn.className = 'recipe-submenu-btn';
				btn.textContent = tag;
				btn.addEventListener('click', () => {
					blogItems.forEach((item) => {
						const itemTags: string[] = JSON.parse(item.dataset.tags || '[]');
						item.hidden = !itemTags.includes(tag);
					});
				});
				li.appendChild(btn);
				list.appendChild(li);
			}

			subMenu.appendChild(list);
			recipeBody.insertBefore(subMenu, blogList);
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => {
				tabs.forEach((t) => t.classList.remove('recipe-tab--active'));
				tab.classList.add('recipe-tab--active');

				if (index === 0) {
					showAllBlogItems();
				} else if (index === 1) {
					showSubMenu(flavorTags);
				} else if (index === 2) {
					showSubMenu(categoryTags);
				}
			});
		});
	};

	document.addEventListener('DOMContentLoaded', () => { initStockPanel(); initRecipeTabs(); });
	document.addEventListener('astro:page-load', () => { initStockPanel(); initRecipeTabs(); });
	initStockPanel();
	initRecipeTabs();
</script>

<style>
	/* ==============================================
	   VA-11 Hall-A: Cyberpunk Bartender Action Theme
	   ============================================== */
	:global(.page-shell__main) {
		padding-top: 0;
		padding-bottom: 0;
	}

	/* ---- CSS Custom Properties ---- */
	.va-panel {
		--va-cyan: #00e5ff;
		--va-cyan-dim: #00b8d4;
		--va-pink: #ff4081;
		--va-pink-glow: #ff80ab;
		--va-green: #69f0ae;
		--va-green-btn: #00c853;
		--va-orange: #ff9100;
		--va-bg: #080c14;
		--va-panel-bg: #0a0f1a;
		--va-panel-border: #0d3b4f;
		--va-text: #c8d6e5;
		--va-text-dim: #5a6a82;
		--va-white: #e8edf5;

		--home-side-space: max(1rem, calc((100% - 1100px) / 2 + 1rem));
		--stock-column-width: clamp(220px, 22vw, 260px);

		position: relative;
		width: 100%;
		box-sizing: border-box;
		min-height: 100vh;
		margin: 0;
		padding: 0 var(--home-side-space) 4rem var(--home-side-space);
		border: none;
		border-radius: 0;
		background:
			/* scanlines */
			repeating-linear-gradient(
				0deg,
				rgba(0, 229, 255, 0.015) 0px,
				rgba(0, 229, 255, 0.015) 1px,
				transparent 1px,
				transparent 3px
			),
			/* subtle dot grid */
			radial-gradient(circle, rgba(0, 229, 255, 0.04) 1px, transparent 1px),
			var(--va-bg);
		background-size: 100% 100%, 16px 16px, 100% 100%;
		font-family: var(--font-atkinson), 'Courier New', monospace;
	}

	/* ---- Header / Branding ---- */
	.va-header {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.8rem 0 1rem;
		border-bottom: 1px solid rgba(0, 229, 255, 0.18);
		margin-bottom: 1.2rem;
	}

	.va-header-left {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.va-header-right {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.35rem;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.7rem;
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--va-cyan);
		text-shadow: 0 0 6px rgba(0, 229, 255, 0.5);
	}

	.lead {
		margin: 0;
		font-size: clamp(1.4rem, 3.2vw, 2rem);
		font-weight: 900;
		letter-spacing: 0.15em;
		line-height: 1.1;
		text-transform: uppercase;
		color: var(--va-pink);
		text-shadow:
			0 0 10px rgba(255, 64, 129, 0.6),
			0 0 30px rgba(255, 64, 129, 0.3);
	}

	.calicomp-badge {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.7rem;
		border: 1px solid var(--va-cyan);
		background: rgba(0, 229, 255, 0.06);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: var(--va-cyan);
		text-transform: uppercase;
	}

	.calicomp-face {
		width: 24px;
		height: 24px;
		border: 1px solid var(--va-cyan);
		background: rgba(0, 229, 255, 0.12);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.65rem;
		line-height: 1;
	}

	.sub {
		margin: 0;
		font-size: 0.82rem;
		letter-spacing: 0.04em;
		color: var(--va-text-dim);
	}

	/* ---- Two-Column Grid ---- */
	.card-grid {
		display: grid;
		gap: 1rem;
		grid-template-columns: minmax(0, 1fr) var(--stock-column-width);
	}

	/* ======= LEFT PANEL: Recipe Browser ======= */
	.card--blog {
		display: flex;
		flex-direction: column;
		border: 2px solid var(--va-cyan);
		background: var(--va-panel-bg);
		padding: 0;
		border-radius: 0;
		box-shadow:
			0 0 12px rgba(0, 229, 255, 0.15),
			inset 0 0 40px rgba(0, 229, 255, 0.03);
		position: relative;
	}

	/* inner white frame like the game */
	.card--blog::after {
		content: '';
		position: absolute;
		inset: 3px;
		border: 1px solid rgba(0, 229, 255, 0.25);
		pointer-events: none;
	}

	/* Tab headers */
	.recipe-tabs {
		display: flex;
		gap: 0;
		border-bottom: 2px solid var(--va-cyan);
		background: rgba(0, 229, 255, 0.04);
		padding: 0;
		margin: 0;
		list-style: none;
		position: relative;
		z-index: 1;
	}

	.recipe-tab {
		padding: 0.55rem 1.2rem;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		color: var(--va-cyan-dim);
		cursor: default;
		border-right: 1px solid rgba(0, 229, 255, 0.15);
		transition: 0.15s ease;
		text-transform: uppercase;
	}

	.recipe-tab:hover {
		color: var(--va-cyan);
		background: rgba(0, 229, 255, 0.06);
	}

	.recipe-tab--active {
		color: var(--va-cyan);
		background: rgba(0, 229, 255, 0.1);
		text-shadow: 0 0 6px rgba(0, 229, 255, 0.4);
	}

	/* Sub-menu for 按口味 / 按种类 (global — created by client JS) */
	:global(.recipe-submenu) {
		padding: 0.45rem 0.7rem;
		border-bottom: 1px solid rgba(0, 229, 255, 0.15);
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-wrap: nowrap;
		gap: 0.25rem;
	}

	:global(.recipe-submenu-back) {
		align-self: flex-start;
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		padding: 0.16rem 0.42rem;
		border: 1px solid var(--va-cyan-dim);
		background: transparent;
		color: var(--va-cyan-dim);
		cursor: pointer;
		transition: 0.15s ease;
		text-transform: uppercase;
	}

	:global(.recipe-submenu-back:hover) {
