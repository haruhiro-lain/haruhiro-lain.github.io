---
import type { CollectionEntry } from 'astro:content';
import CollectionPostPage from '../../../components/CollectionPostPage.astro';
import { getSectionStaticPaths } from '../../../utils/content';

export async function getStaticPaths() {
	return getSectionStaticPaths('life', 'va-11_hall-a');
}

type Props = CollectionEntry<'life'>;

const post = Astro.props as Props;
---

<CollectionPostPage post={post} />

<script>
	// Lock theme to dark on VA-11 Hall-A article pages, restore on leave
	(() => {
		const STORAGE_KEY = 'theme-preference';
		const LOCK_KEY = 'va-theme-saved';

		const saved = localStorage.getItem(STORAGE_KEY);
		if (saved) {
			localStorage.setItem(LOCK_KEY, saved);
		}
		localStorage.setItem(STORAGE_KEY, 'dark');
		document.documentElement.setAttribute('data-theme', 'dark');

		const guard = () => {
			document.documentElement.setAttribute('data-theme', 'dark');
			localStorage.setItem(STORAGE_KEY, 'dark');
			const btn = document.getElementById('theme-toggle');
			if (btn) {
				btn.textContent = '🌙';
				btn.setAttribute('aria-label', '主题已锁定为深色');
			}
		};
		const toggle = document.getElementById('theme-toggle');
		if (toggle) {
			toggle.addEventListener('click', guard, true);
		}
		guard(); // ensure icon is correct on first load

		const observer = new MutationObserver(() => {
			if (document.documentElement.getAttribute('data-theme') !== 'dark') {
				guard();
			}
		});
		observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

		const restore = () => {
			observer.disconnect();
			const prev = localStorage.getItem(LOCK_KEY);
			if (prev) {
				localStorage.setItem(STORAGE_KEY, prev);
			}
			localStorage.removeItem(LOCK_KEY);
		};

		window.addEventListener('beforeunload', restore);
		document.addEventListener('astro:before-swap', restore, { once: true });
	})();
</script>

<style>
	/* Locked theme-toggle on VA-11 Hall-A article pages */
	:global(#theme-toggle) {
		opacity: 0.45;
		border-color: var(--va-cyan, #00e5ff) !important;
		box-shadow: 0 0 10px rgba(0, 229, 255, 0.4), 0 0 20px rgba(0, 229, 255, 0.15);
		cursor: not-allowed !important;
	}
</style>
