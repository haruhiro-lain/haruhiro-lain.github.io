---
import type { CollectionEntry } from 'astro:content';
import CollectionPostPage from '../../../components/CollectionPostPage.astro';
import { getSortedPosts } from '../../../utils/content';

export async function getStaticPaths() {
	const posts = (await getSortedPosts('life')).filter((post) => post.id.startsWith('gk/'));
	return posts.map((post) => ({
		params: { slug: post.id.slice('gk/'.length) },
		props: post,
	}));
}

type Props = CollectionEntry<'life'>;

const post = Astro.props as Props;
---

<CollectionPostPage post={post} />
