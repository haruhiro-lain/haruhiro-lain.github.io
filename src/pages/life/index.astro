---
import PageShell from '../../layouts/PageShell.astro';
import { getSortedPosts } from '../../utils/content';

const posts = await getSortedPosts('life');
const getLifePostHref = (id: string) => {
	if (id.startsWith('gk/')) return `/life/GK/${id.slice('gk/'.length)}/`;
	if (id.startsWith('va-11_hall-a/')) return `/life/VA-11_Hall-A/${id.slice('va-11_hall-a/'.length)}/`;
	return `/life/${id}/`;
};
---

<PageShell title="动态" contentWidth="900px">
	<section>
		<h1>动态</h1>
		<!-- <p>这里是“动态”板块，包含两个独立子页面。</p> -->
		<div class="entry-grid entry-grid--compact">
			<a class="entry-link entry-card" href="/life/weekly">
				<h2>周掸</h2>
				<p>每周更新复盘，大概？...</p>
			</a>
			<a class="entry-link entry-card" href="/life/VA-11_Hall-A">
				<h2>烂酒罐</h2>
				<p>这里记录一些随笔、碎碎念和零散想法。</p>
			</a>
			<a class="entry-link entry-card" href="/life/GK">
				<h2>喷漆间</h2>
				<p>这里记录更自由随性的内容、涂鸦和灵感碎片。</p>
			</a>
		</div>
		{posts.length > 0 ? (
			<section>
				<h2>杂谈文章</h2>
				<ul class="post-list">
					{posts.map((post) => (
						<li>
							<a href={getLifePostHref(post.id)}>
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		) : null}
	</section>
</PageShell>

<style>
	.post-list a {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
	}

	.post-list li {
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 12px;
		padding: 1rem;
	}

	.post-list p {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
	}
</style>
