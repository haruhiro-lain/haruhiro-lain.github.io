---
import FormattedDate from '../../components/FormattedDate.astro';
import PageShell from '../../layouts/PageShell.astro';
import { getGroupedSectionPosts } from '../../utils/content';
import FallbackImage from '../../assets/sunny.jpg';

const collectionOrder = ['algorithms', 'projects', 'others', 'interviews'] as const;
const collectionLabels: Record<(typeof collectionOrder)[number], string> = {
	algorithms: '题解',
	projects: '项目',
	others: '杂项',
	interviews: '面经',
};

const groupedPosts = await getGroupedSectionPosts('learning', collectionOrder);
---

<PageShell title="笔记">
	<section>
		<h1 class="page-title">笔记</h1>

		{groupedPosts.map(({ section, posts }) => {
			const hasMore = posts.length > 6;
			return (
				<div class={`category-section${section === 'interviews' ? ' category-section--interviews' : ''}`}>
					<h2 class="category-title">
						<a href={`/learning/${section}/`}>{collectionLabels[section]}</a>
					</h2>
					<ul class="post-grid">
						{posts.slice(0, 6).map((post) => (
							<li>
								<a href={`/learning/${post.id}/`} class="post-card">
									<div class="post-card__cover">
										<img src={(post.data.heroImage as any)?.src ?? post.data.heroImage ?? FallbackImage.src} alt="" loading="lazy" decoding="async" />
									</div>
									<div class="post-card__body">
										<h3 class="post-card__title">{post.data.title}</h3>
										{post.data.description && <p class="post-card__desc">{post.data.description}</p>}
										{post.data.tags.length > 0 && (
											<ul class="post-card__tags" aria-label="文章标签">
												{post.data.tags.map((tag: string) => (
													<li>#{tag}</li>
												))}
											</ul>
										)}
										<time class="post-card__date">
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
								</a>
							</li>
						))}
					</ul>
					{posts.length === 0 && <p class="empty-indicator">暂无内容</p>}
					{hasMore && <a class="more-indicator" href={`/learning/${section}/`}>...</a>}
				</div>
			);
		})}
	</section>
</PageShell>

<style>
	.page-title {
		margin-bottom: 1.5rem;
	}

	.category-section {
		margin-bottom: 3rem;
	}

	.category-title {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--overlay-border);
	}

	.category-title a {
		text-decoration: none;
		color: inherit;
		transition: color 0.2s;
		cursor: pointer;
	}

	.category-title a:hover {
		color: rgb(var(--accent));
	}

	.more-indicator {
		display: inline-block;
		font-size: 1.5rem;
		color: rgb(var(--gray));
		padding: 1rem 0 0;
		letter-spacing: 0.3em;
		text-decoration: none;
	}

	.more-indicator:hover {
		color: rgb(var(--accent));
	}

	.empty-indicator {
		margin: 0.75rem 0 0;
		font-size: 0.875rem;
		color: rgb(var(--gray));
	}

	.post-grid {
		list-style-type: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		border: 1px solid var(--overlay-border);
		background: var(--overlay-card);
		overflow: hidden;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
		text-decoration: none;
		color: rgb(var(--black));
		height: 100%;
	}

	.post-card:hover {
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
		transform: translateY(-2px);
	}

	.post-card__cover {
		width: 100%;
		aspect-ratio: 16 / 7;
		overflow: hidden;
		background: var(--overlay-border);
	}

	.post-card__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.post-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.85rem 1rem;
		flex: 1;
	}

	.post-card__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.post-card__desc {
		margin: 0;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-card__date {
		margin-top: auto;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.post-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-card__tags li {
		font-size: 0.76rem;
		line-height: 1;
		color: rgb(var(--gray));
		border: 1px solid var(--overlay-border);
		border-radius: 999px;
		padding: 0.2rem 0.45rem;
	}

	@media (max-width: 900px) {
		.post-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 580px) {
		.post-grid {
			grid-template-columns: 1fr;
		}
	}
</style>