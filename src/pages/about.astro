---
import PageShell from '../layouts/PageShell.astro';
import AboutContent from '../data/about.md';
---

<PageShell title="关于" description="关于 Haruhiro 和本博客" contentWidth="900px">

<div class="prose">
<AboutContent />
</div>

</PageShell>

<style>
.prose {
width: 100%;
max-width: 100%;
margin: auto;
padding: 1em;
color: rgb(var(--gray-dark));
}

h2:first-of-type {
margin-top: 0.75rem;
}

a,
a:hover {
color: rgb(var(--black));
}
</style>