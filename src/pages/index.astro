---
import PageShell from '../layouts/PageShell.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getRecentPostsWithCanonical, getRecentSectionPostsWithCanonical } from '../utils/content';
import HomeBannerContent from '../data/home.md';
import RecentScheduleContent from '../data/recentSchedule.md';
import { steamRecentGamesData } from '../data/steamRecentGames';

const recentBlogPosts = await getRecentSectionPostsWithCanonical('learning', 'others', 4);
const recentLifePosts = await getRecentPostsWithCanonical('life', 2, {
	gk: 'GK',
	'va-11_hall-a': 'VA-11_Hall-A',
});
const lightBackgroundImageModules = import.meta.glob('../assets/background/light/*.{png,jpg,jpeg,webp,avif,gif,svg}', {
	eager: true,
	import: 'default',
	query: '?url',
});
const darkBackgroundImageModules = import.meta.glob('../assets/background/dark/*.{png,jpg,jpeg,webp,avif,gif,svg}', {
	eager: true,
	import: 'default',
	query: '?url',
});
const steamCacheImageModules = import.meta.glob('../assets/steam-cache/*.{png,jpg,jpeg,webp,avif,gif,bmp}', {
	eager: true,
	import: 'default',
	query: '?url',
});
const lightBackgroundImages = Object.values(lightBackgroundImageModules) as string[];
const darkBackgroundImages = Object.values(darkBackgroundImageModules) as string[];
const steamCacheImageUrlMap = Object.entries(steamCacheImageModules).reduce(
	(result, [filePath, imageUrl]) => {
		const normalizedPath = filePath.replaceAll('\\', '/');
		const filename = normalizedPath.split('/').pop();
		if (filename) {
			result[filename] = imageUrl as string;
		}
		return result;
	},
	{} as Record<string, string>,
);
const steamRecentGames = steamRecentGamesData.games;
const steamTotalRecentTwoWeeksText = steamRecentGamesData.totalRecentTwoWeeksText || '最近两周时长暂不可用';
const steamFetchedAt = steamRecentGamesData.fetchedAt ? new Date(steamRecentGamesData.fetchedAt) : null;
const githubProfileUrl = 'https://github.com/haruhiro-lain';
const githubAvatarRemoteUrl = `${githubProfileUrl}.png?size=200`;
const githubAvatarCachedUrl = '/steam-cache/github-avatar-haruhiro-lain.png';
---

<PageShell title="首页" contentWidth="900px">
	<section
		id="home-banner-slot"
		class="home-banner-slot"
		aria-label="首页顶部图片预留位"
		data-light-images={encodeURIComponent(JSON.stringify(lightBackgroundImages))}
		data-dark-images={encodeURIComponent(JSON.stringify(darkBackgroundImages))}
	>
		<div class="home-banner-textbox" aria-label="首页壁纸中央文本框">
			<div class="home-banner-card">
				<a
					href={githubProfileUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="home-banner-avatar-link"
					aria-label="打开 GitHub 主页"
				>
					<img src={githubAvatarCachedUrl} alt="GitHub 头像" class="home-banner-avatar" loading="lazy" decoding="async" data-fallback-src={githubAvatarRemoteUrl} />
				</a>
				<div class="home-banner-text-content">
					<HomeBannerContent />
				</div>
			</div>
		</div>
	</section>

	<section class="home-section home-section--schedule">
		<div class="schedule-card" aria-label="最近日程">
			<div class="schedule-card__content">
				<RecentScheduleContent />
			</div>
		</div>
	</section>

	<section class="home-hero">

		<!-- <h1>Haruhiro Blog</h1> -->
	</section>

	<section class="home-section">
		<div class="home-section__head">
			<h2>近期博文</h2>
			<a href="/learning">查看更多</a>
		</div>
		<ul class="home-cards">
			{recentBlogPosts.map(({ post, canonicalId }) => (
				<li>
					<a href={`/learning/${canonicalId}/`} class="home-card">
						{post.data.heroImage && (
							<div class="home-card__cover">
								<img src={(post.data.heroImage as any)?.src ?? post.data.heroImage} alt="" loading="lazy" decoding="async" />
							</div>
						)}
						<div class="home-card__body">
							<h3 class="home-card__title">{post.data.title}</h3>
							{post.data.description && <p class="home-card__desc">{post.data.description}</p>}
							{post.data.tags.length > 0 && (
								<ul class="home-card__tags" aria-label="文章标签">
									{post.data.tags.map((tag) => (
										<li>#{tag}</li>
									))}
								</ul>
							)}
							<time class="home-card__date"><FormattedDate date={post.data.pubDate} /></time>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="home-section">
		<div class="home-section__head">
			<h2>近期动态</h2>
			<a href="/life">查看更多</a>
		</div>
		<ul class="home-cards">
			{recentLifePosts.map(({ post, canonicalId }) => (
				<li>
					<a href={`/life/${canonicalId}/`} class="home-card">
						{post.data.heroImage && (
							<div class="home-card__cover">
								<img src={(post.data.heroImage as any)?.src ?? post.data.heroImage} alt="" loading="lazy" decoding="async" />
							</div>
						)}
						<div class="home-card__body">
							<h3 class="home-card__title">{post.data.title}</h3>
							{post.data.description && <p class="home-card__desc">{post.data.description}</p>}
							{post.data.tags.length > 0 && (
								<ul class="home-card__tags" aria-label="文章标签">
									{post.data.tags.map((tag) => (
										<li>#{tag}</li>
									))}
								</ul>
							)}
							<time class="home-card__date"><FormattedDate date={post.data.pubDate} /></time>
						</div>
					</a>
				</li>
			))}
		</ul>
	</section>

	<section class="home-section home-section--steam">
		<div class="home-section__head">
			<!-- <h2>Steam</h2> -->
			<h2>）不打电动</h2>
			<a href={steamRecentGamesData.profileUrl} target="_blank" rel="noopener noreferrer">查看主页</a>
		</div>
		<div class="steam-card">
			<div class="steam-card__head">
				<h3>最近两周：{steamTotalRecentTwoWeeksText}</h3>
			</div>
			{steamRecentGames.length > 0 ? (
				<ul class="steam-list" id="steam-list">
					{steamRecentGames.map((game) => (
						<li>
							<div class="steam-game__row">
								{(steamCacheImageUrlMap[game.coverImageLocalPath] || game.coverImageUrl) && (
									<a href={game.appUrl} target="_blank" rel="noopener noreferrer" class="steam-game__cover-link" aria-label={`打开 ${game.name} Steam 页面`}>
										<img src={steamCacheImageUrlMap[game.coverImageLocalPath] || game.coverImageUrl} alt={game.name} class="steam-game__cover" loading="lazy" decoding="async" />
									</a>
								)}
								<div class="steam-game__main">
									<div class="steam-game__name-row">
										<a href={game.appUrl} target="_blank" rel="noopener noreferrer" class="steam-game__name">
											{game.name}
										</a>
										{game.lastPlayedText && <span class="steam-game__played">最近游玩：{game.lastPlayedText}</span>}
									</div>
									<div class="steam-game__hours">
										<span>总时长：{game.totalHoursText || '—'}</span>
									</div>
								</div>
							</div>
						</li>
					))}
				</ul>
			) : (
				<p class="steam-empty">暂无可展示的最近游玩数据。</p>
			)}
			{steamFetchedAt && (
				<p class="steam-fetched-at">更新时间：<FormattedDate date={steamFetchedAt} /></p>
			)}
		</div>
	</section>
</PageShell>

<script is:inline>
	const homeBannerSlot = document.getElementById('home-banner-slot');
	if (homeBannerSlot instanceof HTMLElement) {
		const parseImageList = (encodedValue) => {
			if (!encodedValue) {
				return [];
			}

			try {
				const parsed = JSON.parse(decodeURIComponent(encodedValue));
				return Array.isArray(parsed) ? parsed.filter((item) => typeof item === 'string' && item.length > 0) : [];
			} catch {
				return [];
			}
		};

		const lightImages = parseImageList(homeBannerSlot.dataset.lightImages);
		const darkImages = parseImageList(homeBannerSlot.dataset.darkImages);

		// 存储已展示图片的 localStorage key
		const getStorageKey = (theme) => `home-banner-displayed-${theme}`;

		const getNextImage = (images) => {
			if (!Array.isArray(images) || images.length === 0) {
				return '';
			}

			const theme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
			const storageKey = getStorageKey(theme);
			
			// 获取已展示过的图片列表
			let displayedImages = [];
			try {
				const stored = localStorage.getItem(storageKey);
				displayedImages = stored ? JSON.parse(stored) : [];
			} catch {
				displayedImages = [];
			}

			// 如果所有图片都已展示或列表为空，重置
			if (displayedImages.length >= images.length) {
				displayedImages = [];
				localStorage.setItem(storageKey, JSON.stringify(displayedImages));
			}

			// 从未展示过的图片中随机选择
			const availableImages = images.filter((img) => !displayedImages.includes(img));
			if (availableImages.length === 0) {
				// 备选方案：所有都展示过，重置并从全部中选
				displayedImages = [];
				localStorage.setItem(storageKey, JSON.stringify(displayedImages));
				return pickRandomFromArray(images);
			}

			const selectedImage = pickRandomFromArray(availableImages);
			displayedImages.push(selectedImage);
			localStorage.setItem(storageKey, JSON.stringify(displayedImages));

			return selectedImage;
		};

		const pickRandomFromArray = (arr) => {
			if (!Array.isArray(arr) || arr.length === 0) {
				return '';
			}
			const randomIndex = Math.floor(Math.random() * arr.length);
			return arr[randomIndex] || '';
		};

		const applyBannerImage = () => {
			const activeTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
			const selectedImage =
				activeTheme === 'dark'
					? getNextImage(darkImages) || getNextImage(lightImages)
					: getNextImage(lightImages) || getNextImage(darkImages);

			if (selectedImage) {
				homeBannerSlot.style.backgroundImage = `url("${selectedImage}")`;
				homeBannerSlot.classList.add('home-banner-slot--has-image');
				return;
			}

			homeBannerSlot.style.backgroundImage = '';
			homeBannerSlot.classList.remove('home-banner-slot--has-image');
		};

		applyBannerImage();

		const observer = new MutationObserver((mutationList) => {
			for (const mutation of mutationList) {
				if (mutation.type === 'attributes' && mutation.attributeName === 'data-theme') {
					applyBannerImage();
					break;
				}
			}
		});

		observer.observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-theme'],
		});
	}

	const avatarImage = document.querySelector('.home-banner-avatar');
	if (avatarImage instanceof HTMLImageElement) {
		const fallbackSrc = avatarImage.dataset.fallbackSrc;
		if (fallbackSrc) {
			avatarImage.addEventListener(
				'error',
				() => {
					if (avatarImage.src === fallbackSrc) {
						return;
					}
					avatarImage.src = fallbackSrc;
				},
				{ once: true },
			);
		}
	}

	const initSteamBacklogToggles = () => {
		document.querySelectorAll('.steam-toggle').forEach((btn) => {
			if (!(btn instanceof HTMLButtonElement)) {
				return;
			}

			if (btn.dataset.bound === 'true') {
				return;
			}

			btn.dataset.bound = 'true';
			const targetId = btn.dataset.target;
			if (!targetId) {
				return;
			}

			const list = document.getElementById(targetId);
			if (!(list instanceof HTMLUListElement)) {
				return;
			}

			const collapsedCount = 3;
			const updateDisplay = () => {
				const isExpanded = btn.getAttribute('aria-expanded') === 'true';
				const items = Array.from(list.querySelectorAll('li'));
				items.forEach((item, index) => {
					const shouldShow = isExpanded || index < collapsedCount;
					item.classList.toggle('is-collapsed-hidden', !shouldShow);
				});
				btn.textContent = isExpanded ? '收起' : '展开';
			};

			btn.addEventListener('click', () => {
				const isExpanded = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', String(!isExpanded));
				updateDisplay();
			});

			updateDisplay();
		});
	};

	document.addEventListener('DOMContentLoaded', () => {
		initSteamBacklogToggles();
	});

	document.addEventListener('astro:page-load', () => {
		initSteamBacklogToggles();
	});

	initSteamBacklogToggles();
</script>

<style>
	:global(.page-shell__content) {
		padding-top: 0;
	}

	:global(.page-shell__main) {
		padding-top: 0;
	}

	:global(body) {
		overflow-x: clip;
	}

	.home-banner-slot {
		width: 100vw;
		margin-left: calc(50% - 50vw);
		margin-right: calc(50% - 50vw);
		height: 100vh;
		margin-bottom: 1.5rem;
		border-radius: 12px;
		background: color-mix(in srgb, var(--overlay-card) 58%, transparent);
		background-size: cover;
		background-position: center;
		background-repeat: no-repeat;
		position: relative;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.home-banner-slot--has-image {
		background-color: transparent;
	}

	.home-banner-textbox {
		width: 66.66vw;
		min-height: 50vh;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		background: color-mix(in srgb, var(--overlay-bg) 50%, transparent);
		padding: 1.5rem 1.25rem 1.5rem;
		border: 1px solid color-mix(in srgb, var(--overlay-border) 40%, transparent);
		border-radius: 10px;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
	}

	.home-banner-card {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		width: 100%;
		gap: clamp(0.8rem, 2.4vw, 1.4rem);
		padding-left: clamp(0.4rem, 2.2vw, 1.8rem);
	}

	.home-banner-avatar-link {
		display: inline-flex;
		line-height: 0;
		border-radius: 999px;
		flex-shrink: 0;
	}

	.home-banner-avatar {
		width: clamp(78px, 9vw, 124px);
		height: clamp(78px, 9vw, 124px);
		border-radius: 999px;
		object-fit: cover;
		border: 1px solid var(--overlay-border);
	}

	.home-banner-text-content {
		text-align: left;
	}

	.home-banner-text-content :global(h1) {
		margin: 0;
		font-size: clamp(1.8rem, 4vw, 2.6rem);
		line-height: 1.1;
		text-align: left;
	}

	.home-banner-text-content :global(p) {
		margin: 0.7rem 0 0;
		font-size: clamp(0.95rem, 1.4vw, 1.05rem);
		line-height: 1.5;
	}

	.home-hero {
		margin-bottom: 2.25rem;
	}

	.home-hero h1 {
		font-size: clamp(2rem, 5vw, 2.8rem);
		margin-bottom: 0.75rem;
	}

	.home-hero p {
		max-width: 42ch;
	}

	.home-section {
		margin-top: 1.8rem;
	}

	.home-section--schedule {
		margin-top: 1rem;
	}

	.schedule-card {
		border: 1px solid var(--overlay-border);
		border-radius: 10px;
		background: var(--overlay-card);
		padding: 0.85rem 1rem;
	}

	.schedule-card__content {
		font-size: 0.95rem;
		line-height: 1.6;
		color: rgb(var(--black));
	}

	.schedule-card__content :global(h1),
	.schedule-card__content :global(h2),
	.schedule-card__content :global(h3) {
		margin: 0 0 0.55rem;
		font-size: 1.1rem;
	}

	.schedule-card__content :global(h3) {
		margin-top: 0.9rem;
		font-size: 1rem;
	}

	.schedule-card__content :global(h3:first-child) {
		margin-top: 0;
	}

	.schedule-card__content :global(p) {
		margin: 0.45rem 0;
		line-height: 1.5;
	}

	.schedule-card__content :global(ul) {
		margin: 0 0 0.4rem;
		padding-left: 1.2rem;
		display: grid;
		gap: 0.25rem;
	}

	.schedule-card__content :global(li) {
		margin: 0;
		padding-left: 0.1rem;
	}

	.schedule-card__content :global(strong) {
		font-size: 0.98rem;
	}

	.home-section--steam {
		padding-bottom: 1.2rem;
	}

	.home-section__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.7rem;
	}

	.home-section__head h2 {
		font-size: 1.35rem;
		margin: 0;
	}

	.home-section__head a {
		font-size: 0.95rem;
		text-decoration: none;
	}

	.home-cards {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
	}

	.home-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
		color: rgb(var(--black));
		border: 1px solid var(--overlay-border);
		border-radius: 12px;
		background: var(--overlay-card);
		overflow: hidden;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
		height: 100%;
	}

	.home-card:hover {
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
		transform: translateY(-2px);
	}

	.home-card__cover {
		width: 100%;
		aspect-ratio: 16 / 7;
		overflow: hidden;
		background: var(--overlay-border);
	}

	.home-card__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.home-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.85rem 1rem;
		flex: 1;
	}

	.home-card__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.home-card__desc {
		margin: 0;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.home-card__date {
		margin-top: auto;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.home-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.home-card__tags li {
		font-size: 0.76rem;
		line-height: 1;
		color: rgb(var(--gray));
		border: 1px solid var(--overlay-border);
		border-radius: 999px;
		padding: 0.2rem 0.45rem;
	}

	.steam-card {
		border: 1px solid var(--overlay-border);
		border-radius: 10px;
		background: var(--overlay-card);
		padding: 0.75rem 0.85rem;
	}

	.steam-card__head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.6rem;
	}

	.steam-card__head h3 {
		margin: 0;
		font-size: 1rem;
	}

	.steam-toggle {
		border: 1px solid var(--overlay-border);
		background: transparent;
		color: rgb(var(--black));
		border-radius: 8px;
		padding: 0.25rem 0.55rem;
		font-size: 0.85rem;
		cursor: pointer;
	}

	.steam-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}

	.steam-list li {
		border: 1px solid var(--overlay-border);
		border-radius: 8px;
		padding: 0.65rem 0.7rem;
	}

	.steam-game__row {
		display: flex;
		gap: 0.7rem;
		align-items: center;
	}

	.steam-game__cover-link {
		display: block;
		line-height: 0;
		border-radius: 6px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.steam-game__cover {
		display: block;
		width: clamp(140px, 18vw, 170px);
		height: auto;
		border-radius: 6px;
	}

	.steam-game__main {
		min-width: 0;
		flex: 1;
	}

	.steam-game__name-row {
		display: flex;
		justify-content: space-between;
		gap: 0.8rem;
		align-items: baseline;
	}

	.steam-game__name {
		text-decoration: none;
		color: rgb(var(--black));
	}

	.steam-game__played {
		color: rgb(var(--gray));
		font-size: 0.85rem;
		white-space: nowrap;
	}

	.steam-game__hours {
		margin-top: 0.3rem;
		display: flex;
		gap: 1rem;
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}

	.steam-empty {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	.steam-fetched-at {
		margin: 0.6rem 0 0;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.is-collapsed-hidden {
		display: none;
	}

	@media (max-width: 720px) {
		.home-banner-card {
			flex-direction: column;
			justify-content: center;
			width: auto;
			text-align: center;
			padding-left: 0;
		}

		.home-banner-text-content {
			text-align: center;
		}

		.home-cards {
