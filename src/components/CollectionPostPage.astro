---
import { render, type CollectionEntry } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';
import type { ContentCollection } from '../utils/content';

type PostLink = {
	title: string;
	href: string;
};

type Props = {
	post: CollectionEntry<ContentCollection>;
	prevPost?: PostLink;
	nextPost?: PostLink;
};

const { post, prevPost, nextPost } = Astro.props as Props;
const { Content, headings } = await render(post);
const entryPathSegments = post.id.split('/');
entryPathSegments.pop();
const entryBaseDir = `../content/${post.collection}/${entryPathSegments.length > 0 ? `${entryPathSegments.join('/')}/` : ''}`;
---

<BlogPost
	{...post.data}
	headings={headings}
	entryCollection={post.collection}
	entryId={post.id}
	entryBaseDir={entryBaseDir}
	prevPost={prevPost}
	nextPost={nextPost}
>
	<Content />
</BlogPost>