---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import NavDropdown from './NavDropdown.vue';
---

<header>
    <nav>
        <h2><a href="/">{SITE_TITLE}</a></h2>
        <div class="internal-links">
            <HeaderLink href="/">首页</HeaderLink>
            <NavDropdown
                client:load
                label="笔记"
                menuId="submenu-learning"
                items={[
                    { title: '题解', href: '/learning/algorithms' },
                    { title: '项目', href: '/learning/projects' },
                    { title: '杂项', href: '/learning/others' },
                    { title: '面经', href: '/learning/interviews', extraClass: 'submenu-item--interviews' },
                ]}
            />
            <HeaderLink href="/archives">归档</HeaderLink>
            <NavDropdown
                client:load
                label="动态"
                menuId="submenu-life"
                extraClass="nav-item--life"
                items={[
                    { title: '周掸', href: '/life/weekly' },
                    { title: '烂酒罐', href: '/life/VA-11_Hall-A' },
                    { title: '喷漆间', href: '/life/GK' },
                ]}
            />
            <HeaderLink href="/log">日志</HeaderLink>
            <HeaderLink href="/about">关于</HeaderLink>
            <HeaderLink href="/TO-DO" class="nav-item--todo">草稿</HeaderLink>
        </div>
    </nav>
</header>

<style>
    header {
        margin: 0;
        padding: 0;
        position: fixed;
        left: 0;
        right: 0;
        top: 0;
        z-index: 1100;
        pointer-events: none;
        display: flex;
        justify-content: center;
    }
    h2 {
        margin: 0;
        font-size: 1em;
        line-height: 1;
    }

    h2 a,
    h2 a.active {
        display: inline-block;
        font-size: 1.45em;
        line-height: 1;
        text-decoration: none;
    }
    nav {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        width: 100%;
        background: transparent;
        backdrop-filter: blur(16px) saturate(130%);
        -webkit-backdrop-filter: blur(16px) saturate(130%);
        border: none;
        border-radius: 14px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 25%);
        padding: 0.25em 1.4%;
        z-index: 1000;
        box-sizing: border-box;
        gap: 1rem;
        pointer-events: auto;
    }
    h2 {
        position: absolute;
        left: 0.3%;
        top: 50%;
        transform: translateY(-50%);
    }
    nav a {
        padding: 0.35em clamp(0.4rem, 1.8vw, 1.50em);
        font-size: 0.92rem;
        color: rgb(var(--black));
        border-bottom: 4px solid transparent;
        text-decoration: none;
    }
    nav a.active {
        text-decoration: none;
        border-bottom-color: var(--accent);
    }
    nav > h2 > a,
    nav > h2 > a.active {
        font-size: 1.25em;
        line-height: 1;
    }
    .internal-links {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.7rem;
        flex: 0 1 auto;
    }
    @media (max-width: 960px) {
        nav {
            justify-content: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        h2 {
            position: static;
            transform: none;
            width: 100%;
            text-align: center;
        }
        .internal-links {
            flex: 0 1 100%;
            order: 2;
        }
    }
</style>
