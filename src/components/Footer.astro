---
import {
	SITE_FOOTER_NAME,
	SITE_FOOTER_POWERED_BY_NAME,
	SITE_FOOTER_POWERED_BY_URL,
	SITE_START_YEAR,
} from '../consts';

const currentYear = new Date().getFullYear();
const yearText = currentYear <= SITE_START_YEAR ? `${SITE_START_YEAR}` : `${SITE_START_YEAR}-${currentYear}`;
---


<footer class="site-footer" role="contentinfo">
	<div class="site-info-bar" aria-label="站点信息栏">
		<div class="site-info-inner">
			<div class="site-info-left">
				<span class="site-info-year">© {yearText}</span>
				<span class="site-info-sep" aria-hidden="true">·</span>
				<span>{SITE_FOOTER_NAME}</span>
			</div>
			<div class="site-info-right">
				<span>Powered by</span>
				<a href={SITE_FOOTER_POWERED_BY_URL} target="_blank" rel="noopener noreferrer">{SITE_FOOTER_POWERED_BY_NAME}</a>
			</div>
		</div>
	</div>
	<div class="floating-actions">
		<button id="outline-toggle" class="floating-btn" type="button" aria-label="展开侧边栏" aria-pressed="false">≡</button>
		<button id="scroll-top" class="floating-btn" type="button" aria-label="回到顶部">↑</button>
		<button id="theme-toggle" class="floating-btn theme-toggle" type="button" aria-label="切换主题">🌙</button>
	</div>
</footer>

<script is:inline>
	const STORAGE_KEY = 'theme-preference';

	const getPreferredTheme = () => {
		const savedTheme = localStorage.getItem(STORAGE_KEY);
		if (savedTheme === 'light' || savedTheme === 'dark') {
			return savedTheme;
		}
		return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	};

	const applyTheme = (theme) => {
		document.documentElement.setAttribute('data-theme', theme);
		const toggleButton = document.getElementById('theme-toggle');
		if (toggleButton) {
			toggleButton.textContent = theme === 'dark' ? '🌙' : '☀️';
			toggleButton.setAttribute('aria-label', theme === 'dark' ? '当前深色，点击切换到浅色' : '当前浅色，点击切换到深色');
		}
	};

	const initialTheme = getPreferredTheme();
	applyTheme(initialTheme);

	const toggleButton = document.getElementById('theme-toggle');
	if (toggleButton) {
		toggleButton.addEventListener('click', () => {
			const currentTheme = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
			const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
			applyTheme(nextTheme);
			localStorage.setItem(STORAGE_KEY, nextTheme);
		});
	}

	const scrollTopButton = document.getElementById('scroll-top');
	if (scrollTopButton) {
		scrollTopButton.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});
	}

	const outlineToggleButton = document.getElementById('outline-toggle');
	if (outlineToggleButton) {
		let isOutlineLocked = false;

		const updateOutlineButtonState = (locked) => {
			isOutlineLocked = locked;
			outlineToggleButton.classList.toggle('is-active', locked);
			outlineToggleButton.setAttribute('aria-pressed', locked ? 'true' : 'false');
			outlineToggleButton.setAttribute('aria-label', locked ? '收起侧边栏' : '展开侧边栏');
		};

		outlineToggleButton.addEventListener('click', () => {
			updateOutlineButtonState(!isOutlineLocked);
			window.dispatchEvent(
				new CustomEvent('outline-lock-toggle', {
					detail: { locked: isOutlineLocked },
				}),
			);
		});

		window.addEventListener('outline-lock-state-change', (event) => {
			if (!(event instanceof CustomEvent)) {
				return;
			}
			updateOutlineButtonState(event.detail?.locked === true);
		});
	}
</script>

<style>
	footer {
		padding: 0;
		margin: 0;
		background: transparent;
	}

	.site-info-bar {
		width: 100%;
		min-height: 3rem;
		padding: 0;
		box-sizing: border-box;
		font-size: 0.8rem;
		color: rgb(var(--gray-dark));
		background: var(--overlay-bg);
		border-top: 1px solid var(--overlay-border);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
	}

	.site-info-inner {
		width: min(100%, var(--content-width-base));
		max-width: var(--content-width-base);
		min-height: 3rem;
		margin: 0 auto;
		padding: 0 1rem;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.site-info-left,
	.site-info-right {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.site-info-year,
	.site-info-sep {
		white-space: nowrap;
	}

	.site-info-inner a {
		color: inherit;
		text-decoration: underline;
	}

	@media (max-width: 720px) {
		.site-info-inner {
			min-height: 3rem;
			font-size: 0.75rem;
			padding: 0 0.75rem;
			white-space: nowrap;
			overflow-x: auto;
		}

		.site-info-sep {
			margin: 0 0.15rem;
		}
	}

	.floating-actions {
		position: fixed;
		right: 1rem;
		bottom: 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		z-index: 1200;
	}

	.floating-btn {
		width: 2.4rem;
		height: 2.4rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		border-radius: 10px;
		border: 1px solid var(--floating-btn-border);
		background: var(--overlay-bg-strong);
		color: rgb(var(--black));
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		cursor: pointer;
		font: inherit;
		font-size: 1rem;
		line-height: 1;
		box-shadow: var(--box-shadow);
	}

	.floating-btn:hover {
		transform: translateY(-1px);
	}

	.floating-btn.is-active {
		background: var(--overlay-card);
		border-color: var(--accent);
	}
</style>
