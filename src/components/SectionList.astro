---
// src/components/SectionList.astro
import { Image } from 'astro:assets';
import FormattedDate from './FormattedDate.astro';
import PageShell from '../layouts/PageShell.astro';
import FallbackImage from '../assets/blog-placeholder-about.jpg';

interface Props {
	title: string;
	posts: any[];
	collection: string;
}

const { title, posts, collection } = Astro.props as Props;
---

<PageShell title={title} contentWidth="900px">
	<h1 class="section-title">{title}</h1>
	<section>
		{posts.length > 0 ? (
			<>
				<ul class="section-list" id="section-list">
					{posts.map((post) => (
						<li class="section-list__item">
							<a href={`/${collection}/${post.id}/`} class="section-card">
								{post.data.heroImage ? (
									<div class="section-card__cover">
										<Image src={post.data.heroImage} alt="" />
									</div>
								) : (
									<div class="section-card__cover">
										<Image src={FallbackImage} alt="" />
									</div>
								)}
								<div class="section-card__body">
									<h2 class="section-card__title">{post.data.title}</h2>
									{post.data.description && <p class="section-card__desc">{post.data.description}</p>}
									{post.data.tags.length > 0 && (
										<ul class="section-card__tags" aria-label="文章标签">
											{post.data.tags.map((tag: string) => (
												<li>#{tag.trim()}</li>
											))}
										</ul>
									)}
									<time class="section-card__date"><FormattedDate date={post.data.pubDate} /></time>
								</div>
							</a>
						</li>
					))}
				</ul>
				<nav class="section-pagination" id="section-pagination" aria-label="分页导航" hidden>
					<button id="pagination-prev" class="pagination-btn" type="button">上一页</button>
					<span id="pagination-info">1 / 1</span>
					<button id="pagination-next" class="pagination-btn" type="button">下一页</button>
				</nav>
			</>
		) : (
			<p>该板块下暂无文章...</p>
		)}
	</section>
</PageShell>

<script>
	const PAGE_SIZE = 12;
	const list = document.getElementById('section-list');
	const prevBtn = document.getElementById('pagination-prev') as HTMLButtonElement | null;
	const nextBtn = document.getElementById('pagination-next') as HTMLButtonElement | null;
	const info = document.getElementById('pagination-info');
	const pagination = document.getElementById('section-pagination');

	if (list && prevBtn && nextBtn && info && pagination) {
		const items = list.querySelectorAll<HTMLElement>('.section-list__item');
		const totalPages = Math.ceil(items.length / PAGE_SIZE);
		let currentPage = 1;

		if (totalPages <= 1) {
			pagination.hidden = true;
		} else {
			pagination.hidden = false;
		}

		const render = () => {
			items.forEach((item, i) => {
				const page = Math.floor(i / PAGE_SIZE) + 1;
				item.hidden = page !== currentPage;
			});
			info.textContent = `${currentPage} / ${totalPages}`;
			prevBtn.disabled = currentPage <= 1;
			nextBtn.disabled = currentPage >= totalPages;
		};

		prevBtn.addEventListener('click', () => {
			if (currentPage > 1) {
				currentPage -= 1;
				render();
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});

		nextBtn.addEventListener('click', () => {
			if (currentPage < totalPages) {
				currentPage += 1;
				render();
				window.scrollTo({ top: 0, behavior: 'smooth' });
			}
		});

		render();
	}
</script>

<style>
	.section-title {
		margin-bottom: 1.5rem;
	}

	.section-list {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}

	.section-list__item[hidden] {
		display: none;
	}

	.section-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: rgb(var(--black));
		border: 1px solid var(--overlay-border);
		border-radius: 12px;
		background: var(--overlay-card);
		overflow: hidden;
		transition: box-shadow 0.2s ease, transform 0.2s ease;
	}

	.section-card:hover {
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
		transform: translateY(-2px);
	}

	.section-card__cover {
		width: 100%;
		aspect-ratio: 16 / 7;
		overflow: hidden;
		background: var(--overlay-border);
	}

	.section-card__cover img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.section-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 0.85rem 1rem;
		flex: 1;
	}

	.section-card__title {
		margin: 0;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.section-card__desc {
		margin: 0;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.section-card__date {
		margin-top: auto;
		font-size: 0.85rem;
		color: rgb(var(--gray));
	}

	.section-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.section-card__tags li {
		font-size: 0.76rem;
		line-height: 1;
		color: rgb(var(--gray));
		border: 1px solid var(--overlay-border);
		border-radius: 999px;
		padding: 0.2rem 0.45rem;
	}

	.section-pagination {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--overlay-border);
	}

	.section-pagination[hidden] {
		display: none;
	}

	.pagination-btn {
		padding: 0.5rem 1.25rem;
		font-size: 0.9rem;
		border: 1px solid var(--overlay-border);
		border-radius: 8px;
		background: var(--overlay-card);
		color: rgb(var(--black));
		cursor: pointer;
		transition: background 0.2s, border-color 0.2s;
	}

	.pagination-btn:hover:not(:disabled) {
		border-color: rgb(var(--accent));
		color: rgb(var(--accent));
	}

	.pagination-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.pagination-info {
		font-size: 0.9rem;
		color: rgb(var(--gray));
		min-width: 4rem;
		text-align: center;
	}

	@media (max-width: 900px) {
		.section-list {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 580px) {
		.section-list {
			grid-template-columns: 1fr;
		}

		.section-card__body {
			text-align: center;
		}

		.section-card__tags {
			justify-content: center;
		}
	}
</style>